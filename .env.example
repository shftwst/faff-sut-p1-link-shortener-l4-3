# Example configuration for the link-shortener api. Copy to .env and adjust.
# Never commit a real secret: this file documents shape only.

# Postgres DSN (required). When running under docker-compose the host is the
# `db` service; for a local run point it at your own Postgres instance.
DATABASE_URL=postgres://linkshortener:linkshortener@db:5432/linkshortener?sslmode=disable

# TCP listen address (optional; defaults to :8080).
HTTP_ADDR=:8080
