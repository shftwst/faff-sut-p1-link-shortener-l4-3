@@ -0,0 +1,33 @@
+# Two-service topology: the api and its Postgres 16 datastore, each health-checked.
+# `docker compose up -d --build` brings both to healthy well within 60 seconds.
+services:
+  db:
+    image: postgres:16
+    environment:
+      POSTGRES_USER: linkshortener
+      POSTGRES_PASSWORD: linkshortener
+      POSTGRES_DB: linkshortener
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U linkshortener -d linkshortener"]
+      interval: 3s
+      timeout: 3s
+      retries: 15
+      start_period: 5s
+
+  api:
+    build: .
+    environment:
+      DATABASE_URL: postgres://linkshortener:linkshortener@db:5432/linkshortener?sslmode=disable
+      HTTP_ADDR: ":8080"
+    depends_on:
+      db:
+        condition: service_healthy
+    ports:
+      - "8080:8080"
+    restart: on-failure
+    healthcheck:
+      test: ["CMD-SHELL", "wget -q -O - http://localhost:8080/healthz || exit 1"]
+      interval: 3s
+      timeout: 3s
+      retries: 15
+      start_period: 3s
