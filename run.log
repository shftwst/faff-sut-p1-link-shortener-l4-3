nts the integrity dirs (FAFF-517)\",\n  \"budget\": {\n    \"envelope\": {\n      \"ceilings\": {\n        \"until\": null,\n        \"max_attempts\": 30,\n        \"tokens\": 300000000,\n        \"cost\": null\n      },\n      \"until_invalid\": null,\n      \"price_per_mtok_removed\": null,\n      \"at_ceiling\": \"stop\",\n      \"price_per_mtok\": 0,\n      \"pricing\": \"map\",\n      \"window\": null,\n      \"allow_unmetered\": []\n    },\n    \"tokens_at_start_by_model_class\": {\n      \"claude-opus-4-8\": {\n        \"input\": 4,\n        \"output\": 722,\n        \"cache_write\": 36958,\n        \"cache_read\": 32008\n      }\n    },\n    \"tokens_at_start\": 69692,\n    \"measure_session_id\": \"d8dbde82-ff59-4834-bd64-5a74d8eea8e2\",\n    \"metering\": {\n      \"source_at_mint\": \"transcript\",\n      \"degraded\": false\n    }\n  },\n  \"budget_ceiling\": {\n    \"until\": null,\n    \"max_attempts\": 30,\n    \"tokens\": 300000000,\n    \"cost\": null\n  },\n  \"dial_profile\": {\n    \"appetite\": \"full\",\n    \"convergence\": \"forced\",\n    \"slots\": {\n      \"review\": \"faffter-dark-adversarial-review\",\n      \"spec_review\": \"faffter-dark-spec-review\"\n    },\n    \"gates\": null\n  },\n  \"prd_creative_licence\": \"tight\",\n  \"prd_root_container\": \"link-shortener\",\n  \"corrective_authority\": \"channel-D-only\",\n  \"container\": \"contained\",\n  \"floor\": {\n    \"no_execute\": true,\n    \"worktree_isolation\": true,\n    \"autonomous_contract\": true\n  },\n  \"admitted\": [],\n  \"outcomes\": {},\n  \"owner\": {\n    \"status\": \"running\",\n    \"session_id\": null,\n    \"pid\": 433,\n    \"started_at\": \"2026-09-01T00:24:55.232Z\",\n    \"last_heartbeat\": \"2026-09-01T00:24:55.232Z\"\n  }\n}\n\n=== prep marker ===\n{\n  \"issue\": \"gk-20260901-r99do5\",\n  \"spec_produced\": true,\n  \"attached\": true,\n  \"mode\": \"git-only\",\n  \"ts\": \"2026-09-01T00:53:55Z\",\n  \"owner\": {\n    \"run_dir\": \"/Users/shftws