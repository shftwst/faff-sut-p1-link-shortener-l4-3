ng across ALL attempts + fallback backends (distinct from --timeout, which bounds ONE stream attempt)\n787:    else if (k === \"--host-source\") a.hostSource = argv[++i];\n788:    else if (k === \"--provider\") a.provider = argv[++i];\n789:    else if (k === \"--api-key-env\") a.apiKeyEnv = argv[++i];\n790:    else if (k === \"--reasoning-off\") a.reasoningOff = true;\n791:    else if (k === \"--backends-json\") a.backendsJson = argv[++i];   // FAFF-232: ordered fallback chain\n792:    else if (k === \"--lights-out\") a.mandatory = true;   // FAFF-398: mark this review MANDATORY (L4) — a no-opinion chain exhaustion fails closed → needs-human\n793:    else if (k === \"--run-dir\") a.runDir = argv[++i];   // FAFF-401: the run whose run-ledger.json derives mandatory-ness (level:\"L4\"); FAFF_RUN_DIR is the ambient fallback\n794:    else if (k === \"--max-payload-bytes\") a.maxPayloadBytes = Number(argv[++i]);   // FAFF-445: oversized-diff preflight threshold override (test-only escape hatch; default DEFAULT_MAX_PAYLOAD_BYTES applies when absent)\n881:// wall-clock factor (TRANSPORT_RETRY.attempts=3 × 2 streamOnce) between one `--timeout` and one backend's\n898:        `lower this backend's timeout or raise --deadline`,\n1091:export async function main(argv, { runReviewFn = runReview, checkFn = realCheck } = {}) {\n1092:  const a = parseArgs(argv);\n1094:    process.stderr.write(\"usage: review-call.mjs (--host H --model M | --backends-json FILE) --system FILE --diff FILE [--context FILE]... [--num-predict N] [--timeout S] [--deadline S] [--host-source config|default] [--provider P] [--api-key-env VAR] [--reasoning-off] [--max-payload-bytes N]\\n\");\n1098:  // Build the ordered chain (FAFF-232). --backends-json is the COMPLETE chain (a JSON array of backend\n1101:  // --backends-json wins when both are present.\n1106:    catch (e) { process.stderr.write(`--backends-json: cannot read/parse ${a.backendsJson}: ${e.message}\\n`); return EXIT.USAGE; }","is_error":false}]},"