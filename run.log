{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEU9ia2ULSNHPwz83ubgdU","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// FAFF-706 — harness-agnostic concurrent dispatch of review-call.mjs lens invocations.\n3\t//\n4\t// Under Claude Code, issuing N Bash calls in one message happens to run them concurrently — a\n5\t// harness feature, not something faff asked for by name. Under a non-Claude harness (e.g. Codex)\n6\t// there is no such free batching, so the same \"one review-call.mjs invocation per lens\" prose runs\n7\t// the N subprocesses one after another — and each is a full adversarial-review call (preflight,\n8\t// streaming, fallback chain), so a four-lens pass can stall over an hour. This script moves the\n9\t// concurrency out of the harness and into faff's own code: it spawns the N review-call.mjs children\n10\t// itself and awaits them together, so any harness capable of running one shell command gets the\n11\t// same speed-up. Reuses review-call.mjs verbatim (spawned as an unmodified child process) — never\n12\t// forks it. The per-lens outcome mapping and aggregation stay entirely out of this file (see the\n13\t// anti-pattern note below); this is a pure transport concern: spawn, collect, return.\n14\t//\n15\t// Zero-dependency: node stdlib only (node:child_process, node:fs, node:path, node:url).\n16\t// Pure functions (validateRequests) carry no I/O and are unit-tested directly; runOne/fanOut take an\n17\t// injectable spawn function (mirrors review-call.mjs's getFn/streamFn injection) so unit tests spawn\n18\t// nothing unless they opt in; the CLI defaults to the real node:child_process.spawn.\n19\t\n20\timport { spawn } from \"node:child_process\";\n21\timport { readFileSync } from \"node:fs\";\n22\timport { dirname, join as pathJoin } from \"node:path\";\n23\timport { fileURLToPath, pathToFileURL } from \"node:url\";\n24\t\n25\tconst HERE = dirname(fileURLToPath(import.meta.url));\n26\t\n27\t// The shared transport this ticket fans out — spawned unmodified, per-lens, concurrently. Resolved\n28\t// relative to this file so the CLI works regardless of the caller's cwd.\n29\texport const REVIEW_CALL_PATH = pathJoin(HERE, \"review-call.mjs\");\n30\t\n31\t// PURE: is `requests` a non-empty array of well-shaped LensRequest entries ({lens: string, argv:\n32\t// string[]})? Mirrors aggregate.mjs's \"refuses to vote on an absent or inconsistent set\" discipline —\n33\t// fan-out never silently produces fewer than N results, so a malformed/empty input is refused up\n34\t// front rather than partially processed.\n35\texport function validateRequests(requests) {\n36\t  if (!Array.isArray(requests) || requests.length === 0) {\n37\t    return { ok: false, reason: \"requests must be a non-empty array of {lens, argv}\" };\n38\t  }\n39\t  for (const r of requests) {\n40\t    if (!r || typeof r.lens !== \"string\" || !r.lens || !Array.isArray(r.argv)) {\n41\t      return { ok: false, reason: \"each request must be {lens: string, argv: string[]}\" };\n42\t    }\n43\t    // FAFF-706 adversarial review: a non-string argv element (e.g. an undefined interpolated into\n44\t    // the caller's argv assembly, coerced to \"undefined\") would otherwise pass silently — spawn()\n45\t    // itself coerces non-strings to strings, masking a caller bug rather than refusing loudly.\n46\t    if (!r.argv.every((a) => typeof a === \"string\")) {\n47\t      return { ok: false, reason: \"each request's argv must be an array of strings\" };\n48\t    }\n49\t  }\n50\t  return { ok: true };\n51\t}\n52\t\n53\t// Spawn ONE lens request as a child (node reviewCallPath ...argv), draining stdout/stderr AS THEY\n54\t// STREAM (data-event accumulation) — never a post-exit bulk read. This streaming drain is\n55\t// load-bearing, not stylistic: with N children spawned stdio:[_, \"pipe\", \"pipe\"], a child whose\n56\t// output exceeds the OS pipe buffer (~64KB on Linux) blocks on write and never exits if the parent\n57\t// isn't draining that pipe — deadlocking the whole Promise.allSettled batch and silently\n58\t// reintroducing the exact >1h stall this file exists to remove. Adversarial-review refutations are\n59\t// genuinely multi-KB, so this is a live path, not theoretical.\n60\t//\n61\t// Resolves — NEVER rejects — on a normal child exit, even a non-zero one: a lens outcome (mapped by\n62\t// the caller's existing per-lens outcome table), not a fan-out fault. REJECTS only on a spawn()-level\n63\t// fault (e.g. ENOENT — node not found), surfaced via the child's 'error' event (the real\n64\t// child_process.spawn does not throw synchronously for ENOENT); a synchronous throw from an injected\n65\t// test spawnFn is also caught and treated the same way, so both shapes of \"spawn failed before the\n66\t// child started\" are handled identically.\n67\tfunction runOne(request, { spawnFn, nodePath, reviewCallPath }) {\n68\t  return new Promise((resolve, reject) => {\n69\t    let child;\n70\t    try {\n71\t      child = spawnFn(nodePath, [reviewCallPath, ...request.argv], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n72\t    } catch (e) {\n73\t      reject(e);\n74\t      return;\n75\t    }\n76\t    let stdout = \"\";\n77\t    let stderr = \"\";\n78\t    // FAFF-706 adversarial review: `error` and `close` are not mutually exclusive on every platform\n79\t    // (a pipe-teardown fault can fire `error` after a normal `close` already resolved, or vice\n80\t    // versa) — `settled` is the single source of truth for \"has this child's promise already\n81\t    // settled\", so whichever event fires FIRST wins and every later event on this child is a no-op.\n82\t    // This is the only thing standing between a documented single-settle promise and a\n83\t    // silently-ignored second `resolve`/`reject` call (which Node's Promise itself already no-ops,\n84\t    // but relying on that implicitly rather than checking `settled` explicitly would leave the\n85\t    // invariant undocumented for the next reader).\n86\t    let settled = false;\n87\t    child.stdout.on(\"data\", (c) => { stdout += c; });\n88\t    child.stderr.on(\"data\", (c) => { stderr += c; });\n89\t    child.on(\"error\", (e) => {\n90\t      if (settled) return;\n91\t      settled = true;\n92\t      reject(e);\n93\t    });\n94\t    child.on(\"close\", (code) => {\n95\t      if (settled) return;\n96\t      settled = true;\n97\t      resolve({ lens: request.lens, exit: code == null ? 1 : code, stdout, stderr });\n98\t    });\n99\t  });\n100\t}\n101\t\n102\t// Fan every request out as its own child, starting ALL of them before awaiting ANY of them (the\n103\t// `requests.map` below issues every spawn synchronously in one pass), then wait for all of them\n104\t// TOGETHER via Promise.allSettled — turning what was N sequential full-length calls into one batch\n105\t// bounded by the slowest single call. One lens's non-zero exit never delays or blocks sibling lenses'\n106\t// results (Promise.allSettled never cancels or blocks the others on one settling).\n107\t//\n108\t// Returns { ok: true, results: LensResult[] } (same order as `requests`) on a clean fan-out, or\n109\t// { ok: false, fault: string } when ANY child's spawn() itself faulted (distinct from a child that\n110\t// started and exited non-zero) — a fan-out-level fault fails the WHOLE batch, the same fail-loud\n111\t// posture aggregate.mjs already takes on an inconsistent input rather than silently returning fewer\n112\t// results than requested.\n113\texport async function fanOut(requests, { spawnFn = spawn, nodePath = \"node\", reviewCallPath = REVIEW_CALL_PATH } = {}) {\n114\t  const promises = requests.map((r) => runOne(r, { spawnFn, nodePath, reviewCallPath }));\n115\t  const settled = await Promise.allSettled(promises);\n116\t  const rejections = settled.filter((s) => s.status === \"rejected\");\n117\t  if (rejections.length > 0) {\n118\t    // FAFF-706 adversarial review: surface EVERY rejection, not just the first — a batch where two\n119\t    // children both fail to spawn (a resource-exhaustion cascade) reads very differently from one\n120\t    // isolated ENOENT, and the downstream \"treat the whole batch as unavailable\" handling is\n121\t    // unaffected either way (still ok:false), so this only improves diagnosability.\n122\t    const messages = rejections.map((r) => (r.reason instanceof Error ? r.reason.message : String(r.reason)));\n123\t    const fault = rejections.length === 1\n124\t      ? messages[0]\n125\t      : `${rejections.length} of ${requests.length} children failed to spawn — first: ${messages[0]}; all: ${messages.join(\" | \")}`;\n126\t    return { ok: false, fault };\n127\t  }\n128\t  return { ok: true, results: settled.map((s) => s.value) };\n129\t}\n130\t\n131\t// ---- CLI ------------------------------------------------------------------\n132\t// Input (stdin or --requests FILE) is JSON: either a bare array of LensRequest, or an object\n133\t// { requests: [...] } — mirrors aggregate.mjs's dual-mode CLI shape.\n134\tfunction readRequestsInput(argv) {\n135\t  const fi = argv.indexOf(\"--requests\");\n136\t  // FAFF-706 adversarial review: a trailing `--requests` with no filename (fi is the last index)\n137\t  // would otherwise reach readFileSync(undefined) and surface an unhelpful internal TypeError —\n138\t  // catch it here with a message that actually names the mistake.\n139\t  if (fi !== -1 && fi + 1 >= argv.length) {\n140\t    throw new Error(\"--requests requires a FILE argument\");\n141\t  }\n142\t  const raw = fi !== -1 ? readFileSync(argv[fi + 1], \"utf8\") : readFileSync(0, \"utf8\");\n143\t  const parsed = JSON.parse(raw);\n144\t  if (Array.isArray(parsed)) return parsed;\n145\t  if (parsed && Array.isArray(parsed.requests)) return parsed.requests;\n146\t  return parsed; // let validateRequests reject a non-array/non-{requests:[]} shape uniformly\n147\t}\n148\t\n149\t// `spawnFn` is injectable exactly as review-call.mjs's getFn/streamFn are, so a caller (or test) can\n150\t// stub the transport; it defaults to the real node:child_process.spawn for the CLI.\n151\texport async function main(argv, { spawnFn = spawn } = {}) {\n152\t  let requests;\n153\t  try {\n154\t    requests = readRequestsInput(argv);\n155\t  } catch (e) {\n156\t    process.stderr.write(`fan-out: cannot read/parse --requests — ${e.message}\\n`);\n157\t    return 1;\n158\t  }\n159\t  const v = validateRequests(requests);\n160\t  if (!v.ok) {\n161\t    process.stderr.write(`fan-out: ${v.reason}\\n`);\n162\t    return 1;\n163\t  }\n164\t  const outcome = await fanOut(requests, { spawnFn });\n165\t  if (!outcome.ok) {\n166\t    process.stderr.write(`fan-out: spawn fault — ${outcome.fault}\\n`);\n167\t    return 1;\n168\t  }\n169\t  process.stdout.write(JSON.stringify(outcome.results) + \"\\n\");\n170\t  return 0;\n171\t}\n172\t\n173\t// Anti-pattern (see the spec's Design Decision Rationale): this file never re-derives the per-lens\n174\t// outcome mapping (exit → refuted/clear/unavailable) — that mapping is spec-review's own judgement,\n175\t// consumed by aggregate.mjs's contract-shaped input. fan-out.mjs stays a pure transport concern\n176\t// (spawn, collect, return) so it can be reused unmodified anywhere a set of review-call.mjs calls\n177\t// needs to run concurrently.\n178\t\n179\t// Run as CLI only when invoked directly (not when imported by a test). Mirrors aggregate.mjs's\n180\t// import.meta.url / pathToFileURL(process.argv[1]) comparison (percent-encoding safe).\n181\tif (import.meta.url === pathToFileURL(process.argv[1]).href) {\n182\t  main(process.argv.slice(2)).then((code) => { process.exitCode = code; });\n183\t}\n184\t"}]},"parent_tool_use_id":"toolu_018uez6EFKiHNDKixT1pCgLF","session_id":"21bdc136-befe-4bc5-9026-5312f63ae86b","uuid":"61a57d76-c231-4029-bdb8-847951ed44f7","timestamp":"2026-09-01T01:20:57.303Z","subagent_type":"general-purpose","task_description":"Resume E1 spec-review gate"}
