{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QSRdYJkebD6poLHN4eThAm","type":"tool_result","content":"1347\tfunction computePrdrAdmissionVerdict(input) {\n1348\t  const reasons = [];\n1349\t  // (B) recursive invariant: human is the outermost encloser (always ok); a loop operating UNDER the\n1350\t  // PRDR it would supersede (`self`) cannot move its own setpoint → by_level violation.\n1351\t  const by_level = input.actor === \"human\" ? \"ok\" : (input.self ? \"violation\" : \"ok\");\n1352\t  const authority = { actor: input.actor, supersedes_provenance: input.supersedesProvenance, by_level };\n1353\t\n1354\t  // (C) thrash-ratchet (count half): lineage count within window is agent-supplied; the CLI compares\n1355\t  // it to thrash_max. (The per-supersession adversarial drift review is the `review` slot's job.)\n1356\t  const lineage = Number.isInteger(input.lineageSupersessions) ? input.lineageSupersessions : 0;\n1357\t  const breached = lineage >= input.thrashMax;\n1358\t  const ratchet = { lineage_supersessions: lineage, breached };\n1359\t\n1360\t  // upper (256) — absent ⇒ fail-safe: a NEW-capability PRDR is not admitted (no YAGNI judge to vouch\n1361\t  // it isn't gold-plating); a like-for-like supersession is admitted.\n1362\t  let upper;\n1363\t  if (input.upper && typeof input.upper === \"object\" && !Array.isArray(input.upper)) {\n1364\t    upper = { admit: !!input.upper.admit, reason: typeof input.upper.reason === \"string\" ? input.upper.reason : \"\" };\n1365\t  } else {\n1366\t    const admit = !input.newCapability;\n1367\t    upper = { admit, reason: admit ? \"fail-safe default: 256 absent — like-for-like supersession admitted\" : \"fail-safe default: 256 absent — new-capability PRDR not admitted (no YAGNI judge)\" };\n1368\t  }\n1369\t  // lower (257) — absent ⇒ conservative: a supersession that drops a goal's last live PRDR is not\n1370\t  // covered (escalate; never silently abandon a goal).\n1371\t  let lower;\n1372\t  if (input.lower && typeof input.lower === \"object\" && !Array.isArray(input.lower)) {\n1373\t    lower = { covered: !!input.lower.covered, uncovered_goals: Array.isArray(input.lower.uncovered_goals) ? input.lower.uncovered_goals.filter((g) => typeof g === \"string\") : [] };\n1374\t  } else {\n1375\t    lower = { covered: !input.dropsLastGoal, uncovered_goals: input.dropsLastGoal ? [\"<257 absent: supersession drops a goal's last live PRDR>\"] : [] };\n1376\t  }\n1377\t\n1378\t  const loopSupersedesHuman = authority.actor === \"loop\" && authority.supersedes_provenance === \"human\";\n1379\t  const gatesPass = prdrGatesPass(upper, by_level, ratchet, lower);\n1380\t\n1381\t  let disposition;\n1382\t  if (gatesPass && !loopSupersedesHuman) {\n1383\t    disposition = \"admit\";\n1384\t  } else if (gatesPass && loopSupersedesHuman) {\n1385\t    disposition = \"propose-only\";\n1386\t    reasons.push(\"loop supersedes a human-provenance PRDR — propose-only; effective only on human tracker ratification (Status: Accepted). The loop never self-ratifies.\");\n1387\t  } else {\n1388\t    disposition = \"reject\";\n1389\t    if (!upper.admit) reasons.push(`upper/YAGNI gate did not admit: ${upper.reason}`);\n1390\t    if (by_level === \"violation\") reasons.push(\"by-level violation — actor cannot supersede the PRDR governing its own increment (per-increment immutability)\");\n1391\t    if (breached) reasons.push(`thrash ratchet breached — lineage accrued ${lineage} supersession(s) (≥ thrash_max ${input.thrashMax}) within window — escalate to human`);\n1392\t    if (!lower.covered) reasons.push(`lower/coverage gate: supersession would leave a PRD goal uncovered — escalate, no silent abandonment${lower.uncovered_goals.length ? \" (\" + lower.uncovered_goals.join(\", \") + \")\" : \"\"}`);\n1393\t    if (loopSupersedesHuman) reasons.push(\"note: also a loop→human supersession (would be propose-only were it not for the hard violation above)\");\n1394\t  }\n1395\t  return { disposition, upper, lower, authority, ratchet, reasons, conformant: true, violations: [] };\n1396\t}\n1397\t\n1398\t// --- adr-admission (FAFF-199) ---\n1399\t// The ADR-axis sibling of prdr-admission: a two-gate-bound admission verdict that lets the loop\n1400\t// supersede its OWN earlier ADRs (\"loop-provenance\") while human/legacy-provenance ADRs stay\n1401\t// guardrails (\"propose-only\"). Ports ADR 0022's PRDR pattern verbatim for authority/by-level/ratchet;\n1402\t// the PRD-specific upper(YAGNI)/lower(coverage) value gates have no ADR analogue, so they are\n1403\t// replaced by ONE folded `challenge` gate — the per-move adversarial drift review (a different\n1404\t// model re-examines the supersession argument). `faff adr admit` is the PRODUCER\n1405\t// (computeAdrAdmissionVerdict); THIS is the consumer-side SHAPE validator (mirrors\n1406\t// computePrdrAdmission). NO safe coerce target — faff's own producer emits it, so an out-of-enum\n1407\t// disposition/authority/challenge value is an assignment bug → fail-loud (never coerced toward\n1408\t// `admit`). The load-bearing invariant guarded here: an `admit` disposition MUST satisfy the\n1409\t// two-gate constraint (challenge.outcome==survived ∧ by_level==ok ∧ ¬ratchet.breached ∧\n1410\t// ¬(loop supersedes human)). A missing/unreachable challenge (`outcome: absent`) is a REJECT\n1411\t// reason, never coerced to `survived` — \"a missing adversarial challenge is a reject, never a\n1412\t// pass\" (fail-safe toward the harder-to-supersede tier).\n1413\tconst ADR_CHALLENGE_OUTCOMES = [\"survived\", \"overturned\", \"absent\"];\n1414\t\n1415\t// Does the verdict's gate state permit `admit`? Shared by producer + validator so the constraint\n1416\t// has one definition (mirrors prdrGatesPass). A missing/overturned challenge never passes.\n1417\tfunction adrGatesPass(challengeOutcome, by_level, ratchet) {\n1418\t  return challengeOutcome === \"survived\" && by_level === \"ok\" && !ratchet.breached;\n1419\t}\n1420\t\n1421\tfunction computeAdrAdmission(extraction) {\n1422\t  if (extraction === null || typeof extraction !== \"object\" || Array.isArray(extraction)) {\n1423\t    return { contractData: null, failLoud: \"extraction must be a JSON object\" };\n1424\t  }\n1425\t  if (!PRDR_DISPOSITIONS.includes(extraction.disposition)) {\n1426\t    return { contractData: null, failLoud: `disposition ${JSON.stringify(extraction.disposition)} not in {admit,propose-only,reject} — no safe coerce target` };\n1427\t  }\n1428\t  const a = extraction.authority;\n1429\t  if (a === null || typeof a !== \"object\" || Array.isArray(a)) {\n1430\t    return { contractData: null, failLoud: \"authority must be an object\" };\n1431\t  }\n1432\t  if (!PRDR_ACTORS.includes(a.actor)) return { contractData: null, failLoud: `authority.actor ${JSON.stringify(a.actor)} not in {loop,human}` };\n1433\t  if (!PRDR_SUPERSEDES.includes(a.supersedes_provenance)) return { contractData: null, failLoud: `authority.supersedes_provenance ${JSON.stringify(a.supersedes_provenance)} not in {human,loop,none}` };\n1434\t  if (!PRDR_BY_LEVEL.includes(a.by_level)) return { contractData: null, failLoud: `authority.by_level ${JSON.stringify(a.by_level)} not in {ok,violation}` };\n1435\t\n1436\t  const ch = extraction.challenge;\n1437\t  if (ch === null || typeof ch !== \"object\" || Array.isArray(ch)) {\n1438\t    return { contractData: null, failLoud: \"challenge must be an object\" };\n1439\t  }\n1440\t  if (!ADR_CHALLENGE_OUTCOMES.includes(ch.outcome)) return { contractData: null, failLoud: `challenge.outcome ${JSON.stringify(ch.outcome)} not in {survived,overturned,absent}` };\n1441\t  const challenge = { ran: !!ch.ran, outcome: ch.outcome };\n1442\t\n1443\t  const violations = [];\n1444\t  const ra = (extraction.ratchet && typeof extraction.ratchet === \"object\" && !Array.isArray(extraction.ratchet)) ? extraction.ratchet : {};\n1445\t  let lineage = ra.lineage_supersessions;\n1446\t  if (!Number.isInteger(lineage)) { violations.push(`ratchet.lineage_supersessions ${JSON.stringify(lineage)} not an integer — normalised to 0`); lineage = 0; }\n1447\t  const ratchet = { lineage_supersessions: lineage, breached: !!ra.breached };\n1448\t  const authority = { actor: a.actor, supersedes_provenance: a.supersedes_provenance, by_level: a.by_level };\n1449\t  const reasons = Array.isArray(extraction.reasons) ? extraction.reasons.filter((r) => typeof r === \"string\") : [];\n1450\t\n1451\t  const loopSupersedesHuman = authority.actor === \"loop\" && authority.supersedes_provenance === \"human\";\n1452\t  const gatesPass = adrGatesPass(challenge.outcome, authority.by_level, ratchet);\n1453\t  // The load-bearing conformance: an `admit` must have actually passed every gate AND not be a\n1454\t  // loop→human move; a `propose-only` is valid ONLY when gates pass and that move is the sole bar.\n1455\t  if (extraction.disposition === \"admit\" && !(gatesPass && !loopSupersedesHuman)) {\n1456\t    violations.push(\"admit disposition violates the two-gate constraint (requires challenge.outcome==survived ∧ by_level==ok ∧ ¬ratchet.breached ∧ ¬(loop supersedes human))\");\n1457\t  }\n1458\t  if (extraction.disposition === \"propose-only\" && !(gatesPass && loopSupersedesHuman)) {\n1459\t    violations.push(\"propose-only is valid only when all gates pass and the sole bar is a loop superseding a human-provenance ADR\");\n1460\t  }\n1461\t  return { contractData: { disposition: extraction.disposition, authority, challenge, ratchet, reasons, conformant: violations.length === 0, violations }, failLoud: null };\n1462\t}\n1463\t\n1464\tfunction contractAdrAdmission(extraction) {\n1465\t  const { contractData, failLoud } = computeAdrAdmission(extraction);\n1466\t  if (failLoud) return { failLoud };\n1467\t  const schemaErr = schemaCheck(contractData, \"adr-admission\");\n1468\t  if (schemaErr) return { failLoud: schemaErr };\n1469\t  return { contractData };\n1470\t}\n1471\t"}]},"parent_tool_use_id":"toolu_01B5