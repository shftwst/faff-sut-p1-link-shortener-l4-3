{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UL9ULXbwTp5PDUHW8uJi3q","type":"tool_result","content":"27:  \"--lineage-supersessions\": { arity: 1 }, \"--live-prdrs\": { arity: 1 }, \"--lower\": { arity: 1 },\n30:  \"--supersedes-provenance\": { arity: 1 }, \"--thrash-max\": { arity: 1 }, \"--to\": { arity: 1 }, \"--upper\": { arity: 1 },\n55:const { PRDR_ACTORS, PRDR_SUPERSEDES, PRDR_YAGNI_CHALLENGE_GROUNDS, PRDR_YAGNI_PROPOSAL_VERDICTS, computePrdCoverage, computePrdCoverageVerdict, computePrdDistance, contractPrdDistance, computePrdrAdmission, computePrdrAdmissionVerdict, computePrdrYagni, computePrdrYagniVerdict } = require(\"./contract-defs\");\n669:    let upper = null, lower = null;\n670:    const upRaw = get(\"--upper\");\n671:    if (upRaw != null) { try { upper = JSON.parse(upRaw); } catch (e) { process.stderr.write(`faff prdr admit: --upper is not valid JSON: ${e.message}\\n`); return 2; } }\n672:    const loRaw = get(\"--lower\");\n673:    if (loRaw != null) { try { lower = JSON.parse(loRaw); } catch (e) { process.stderr.write(`faff prdr admit: --lower is not valid JSON: ${e.message}\\n`); return 2; } }\n674:    const verdict = computePrdrAdmissionVerdict({\n679:      lineageSupersessions, thrashMax, upper, lower,\n692:    // `upper` shape (admit, reason) plus the audit trail; feed it to `faff prdr admit --upper`.\n738:    // Emits 255's `lower` shape at the top level ({covered, uncovered_goals} — feed to `prdr admit --lower`)\n911:  const adm = (opts) => computePrdrAdmissionVerdict({ thrashMax: 3, ...opts });\n916:  t(\"new-capability + 256 absent → reject (fail-safe, no gold-plating)\", (() => { const v = adm({ actor: \"loop\", supersedesProvenance: \"none\", newCapability: true }); return v.disposition === \"reject\" && v.upper.admit === false; })());\n917:  t(\"like-for-like + 256 absent → upper admits (fail-safe)\", adm({ actor: \"loop\", supersedesProvenance: \"loop\" }).upper.admit === true);\n918:  t(\"drops-last-goal + 257 absent → reject (coverage, no silent abandonment)\", (() => { const v = adm({ actor: \"loop\", supersedesProvenance: \"loop\", dropsLastGoal: true }); return v.disposition === \"reject\" && v.lower.covered === false; })());\n921:  t(\"explicit --upper admit:false → reject\", adm({ actor: \"loop\", supersedesProvenance: \"loop\", upper: { admit: false, reason: \"yagni\" } }).disposition === \"reject\");\n922:  t(\"explicit --lower covered:false → reject\", adm({ actor: \"loop\", supersedesProvenance: \"loop\", lower: { covered: false, uncovered_goals: [\"g\"] } }).disposition === \"reject\");\n929:  // --- FAFF-256: the upper (YAGNI) gate producer ---\n939:  t(\"verdict emits 255's upper shape {admit,reason}\", (() => { const v = yag({}); return typeof v.admit === \"boolean\" && typeof v.reason === \"string\"; })());\n950:  t(\"admit verdict round-trips through admit --upper to admit disposition\", (() => {\n952:    const v = computePrdrAdmissionVerdict({ actor: \"loop\", supersedesProvenance: \"loop\", thrashMax: 3, upper: { admit: up.admit, reason: up.reason } });\n953:    return v.upper.admit === true && v.disposition === \"admit\";\n955:  t(\"reject verdict round-trips through admit --upper to reject disposition\", (() => {\n957:    const v = computePrdrAdmissionVerdict({ actor: \"loop\", supersedesProvenance: \"loop\", thrashMax: 3, upper: { admit: up.admit, reason: up.reason } });\n958:    return v.upper.admit === false && v.disposition === \"reject\";\n1009:    return v.covered === true && v.uncovered_goals.length === 0;\n1013:    return v.covered === false && v.uncovered_goals.length === 4;\n1118:  // --- FAFF-257: the lower (coverage) gate + prd-satisfied roll-up producer ---\n1120:  t(\"every goal covered → covered (lower admits)\", cov({}).covered === true && cov({}).uncovered_goals.length === 0);\n1121:  t(\"a goal with no live PRDR → uncovered (lower violation, no silent abandonment)\", (() => {\n1123:    return v.covered === false && v.uncovered_goals.includes(\"reduce no-shows\");\n1128:    return v.covered === false && v.satisfied === false && /uncovered goals/.test(v.reason);\n1132:    return v.covered === true && v.completion.all_met === true && v.satisfied === true && v.reason === \"\";\n1136:    return v.covered === true && v.satisfied === false && v.completion.all_met === false && v.completion.unmet_or_unverified.length === 2 && /unmet\\/unverified/.test(v.reason);\n1140:    return v.covered === true && v.satisfied === false && v.completion.unmet_or_unverified.includes(\"0002\");\n1156:    return before.satisfied === false && wrote === true && rec.dod_verdict === \"met\" && after.covered === true && after.satisfied === true;\n1177:    return v.covered === true && v.satisfied === true && v.uncovered_goals.length === 0;\n1183:  t(\"lower shape feeds prdr admit --lower → reject on uncovered\", (() => {\n1185:    const adm2 = computePrdrAdmissionVerdict({ actor: \"loop\", supersedesProvenance: \"loop\", thrashMax: 3, lower: { covered: v.covered, uncovered_goals: v.uncovered_goals } });","is_error":false}]},"parent_tool_use_id":"toolu_01B5EZakvE3ogy965XNLhXi4","session_id":"21bdc136-befe-4bc5-9026-5312f63ae86b","uuid":"cc231c40-1572-4128-86ef-dbb3ee7fa405","timestamp":"2026-09-01T00:38:49.989Z","subagent_type":"general-purpose","task_description":"Plot PRD into epics and PRDRs"}
