{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ALqbJ4uy4Y975szJfVsJuu","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// FAFF-267 — deterministic majority/severity aggregation for the L4 adversarial spec reviewer.\n3\t//\n4\t// The per-lens refuters (independent `review-call.mjs` passes) produce a list of Refutations; this\n5\t// helper maps that set onto the fixed `spec-review-verdict` contract. Per the governing\n6\t// deterministic-tools-over-prose tenet, the severity→verdict roll-up is a tool, not prose — same\n7\t// refutation set always yields the same verdict. The contract validates verdict SHAPE only (and keeps\n8\t// this mapping out, by design); this is the reviewer's judgement, owned by this occupant.\n9\t//\n10\t// Pure functions carry no I/O and are unit-tested directly; the CLI is a thin stdin→stdout wrapper.\n11\t// Zero-dependency: node stdlib only (node:fs, node:url).\n12\t\n13\timport { readFileSync, realpathSync } from \"node:fs\";\n14\timport { pathToFileURL } from \"node:url\";\n15\t\n16\t// The contract severity enum is blocker|major|minor. Refuters speak the adversarial-review\n17\t// vocabulary (critical|major|minor|observation); map it onto the contract enum. An `observation`\n18\t// is advisory and NEVER gates (mapped to null = dropped). An unknown severity is treated the same.\n19\texport const SEVERITY_MAP = { critical: \"blocker\", major: \"major\", minor: \"minor\", observation: null };\n20\texport function mapSeverity(s) {\n21\t  return Object.prototype.hasOwnProperty.call(SEVERITY_MAP, s) ? SEVERITY_MAP[s] : null;\n22\t}\n23\t\n24\t// PURE: strict majority of n enabled lenses — the count at or above which \"most lenses refuted\".\n25\t// ceil((n+1)/2): n=1→1, n=2→2, n=3→2, n=4→3. (A single enabled lens refuting is already a majority;\n26\t// two of four is a tie, not a majority.)\n27\texport function strictMajority(n) {\n28\t  return Math.ceil((n + 1) / 2);\n29\t}\n30\t\n31\t// PURE: the majority/severity gate. Maps a list of Refutations onto { verdict, objections }, where\n32\t// objections is the contract shape List<{ lens, severity }>. A lens counts as \"refuted\" iff it\n33\t// carries at least one GATING objection (observation-only / empty → clear). `nEnabled` is the count\n34\t// of lenses that fired for this issue (default: the number of refutations supplied).\n35\t//\n36\t// Refutation: { lens, outcome: \"refuted\"|\"clear\"|\"unavailable\", kind?: \"infra-configured\"|\"config-fault\",\n37\t//               objections: [{ severity, claim?, evidence?, predicted_consequence?, summary? }], model? }\n38\t//\n39\t// FAFF-935: an objection may carry the enrichment triple {claim, evidence, predicted_consequence}\n40\t// (the argued content a downstream judge reads). FAFF-943 adds `spec_anchor` — the heading slug of\n41\t// the attacked spec section (canonical derivation: faff bin/lib/heading-slug.js; the refuter omits\n42\t// it when no single section is nameable, and a transport-floor synthesized objection never carries\n43\t// one). aggregate() carries each field VERBATIM from the source objection onto the output objection\n44\t// when present as a string — additive, so the fields survive into the round record and thence\n45\t// `faff spec-judge-evidence`. It changes NO gating input: the severity map, the\n46\t// refutedCount/anyCritical tally, and the majority gate are untouched.\n47\tconst TRIPLE_FIELDS = [\"claim\", \"evidence\", \"predicted_consequence\", \"spec_anchor\"];\n48\tfunction carryTriple(target, source) {\n49\t  if (source && typeof source === \"object\") {\n50\t    for (const field of TRIPLE_FIELDS) {\n51\t      if (typeof source[field] === \"string\") target[field] = source[field];\n52\t    }\n53\t  }\n54\t  return target;\n55\t}\n56\texport function aggregate(refutations, nEnabled) {\n57\t  const list = Array.isArray(refutations) ? refutations : [];\n58\t\n59\t  const gating = [];          // contract-shaped objections across all available lenses\n60\t  let anyCritical = false;\n61\t  let refutedCount = 0;\n62\t  for (const r of list) {\n63\t    if (!r || r.outcome === \"unavailable\") continue;\n64\t    const objs = Array.isArray(r.objections) ? r.objections : [];\n65\t    const lensGating = [];\n66\t    for (const o of objs) {\n67\t      const sev = mapSeverity(o && o.severity);\n68\t      if (sev === null) continue;            // advisory / unknown — non-gating\n69\t      if (o && o.severity === \"critical\") anyCritical = true;\n70\t      lensGating.push(carryTriple({ lens: r.lens, severity: sev }, o));\n71\t    }\n72\t    if (lensGating.length > 0) {\n73\t      refutedCount += 1;\n74\t      gating.push(...lensGating);\n75\t    }\n76\t  }\n77\t\n78\t  const n = Number.isInteger(nEnabled) && nEnabled > 0 ? nEnabled : list.length;\n79\t  const majority = strictMajority(n);\n80\t  const forcedReject = anyCritical || refutedCount >= majority;\n81\t\n82\t  const unavailable = list.filter((r) => r && r.outcome === \"unavailable\");\n83\t  const configFault = unavailable.filter((r) => r.kind === \"config-fault\");\n84\t  const nameLenses = (rs, severity) => rs.map((r) => ({ lens: r.lens, severity }));\n85\t\n86\t  // 1. Transport floor — a config fault must be fixed by a human, always (even if the available\n87\t  //    lenses already force reject-approach): a misconfigured/auth-failed/default-host-down refuter\n88\t  //    is not a review result.\n89\t  if (configFault.length > 0) {\n90\t    return { verdict: \"needs-human\", objections: [...gating, ...nameLenses(configFault, \"blocker\")] };\n91\t  }\n92\t  // 1b. FAFF-900: an (infra-configured) down lens whose missing vote could swing the verdict is a\n93\t  //     TRANSIENT the orchestrator can hold and retry — surface the distinct `unavailable` verdict\n94\t  //     (never `needs-human`, which reads as \"a human must act\"; a swing-capable infra outage is\n95\t  //     recoverable without one). Severity defaults to \"major\" (the founded default for a lens with\n96\t  //     no actual finding to grade — distinct from the config-fault \"blocker\" above, which names a\n97\t  //     human config bug). If the available lenses already force reject-approach, the missing lens\n98\t  //     cannot change it — fall through to the gate below.\n99\t  if (unavailable.length > 0 && !forcedReject) {\n100\t    return { verdict: \"unavailable\", objections: [...gating, ...nameLenses(unavailable, \"major\")] };\n101\t  }\n102\t  // 2. Severity veto — any critical objection.\n103\t  if (anyCritical) return { verdict: \"reject-approach\", objections: gating };\n104\t  // 3. Majority gate — strict majority of ENABLED lenses refuted.\n105\t  if (refutedCount >= majority) return { verdict: \"reject-approach\", objections: gating };\n106\t  // 4. Non-critical minority — fixable in place.\n107\t  if (refutedCount > 0) return { verdict: \"revise\", objections: gating };\n108\t  // 5. Clean.\n109\t  return { verdict: \"approve\", objections: [] };\n110\t}\n111\t\n112\t// PURE: render the producer's single contract artifact block from an aggregate() result.\n113\texport function renderBlock(result) {\n114\t  return \"```faff-contract:spec-review-verdict\\n\" + JSON.stringify(result) + \"\\n```\\n\";\n115\t}\n116\t\n117\t// ---- CLI ----------------------------------------------------------------\n118\t// Input (stdin or --refutations FILE) is JSON: either a bare array of Refutations, or an object\n119\t// { refutations: [...], enabled_lenses: [...] }. --n N overrides the enabled-lens count.\n120\tfunction readInput(args) {\n121\t  const fi = args.indexOf(\"--refutations\");\n122\t  const raw = fi !== -1 ? readFileSync(args[fi + 1], \"utf8\") : readFileSync(0, \"utf8\");\n123\t  const parsed = JSON.parse(raw);\n124\t  if (Array.isArray(parsed)) return { refutations: parsed, nEnabled: undefined };\n125\t  const refutations = Array.isArray(parsed.refutations) ? parsed.refutations : [];\n126\t  const nEnabled = Array.isArray(parsed.enabled_lenses) ? parsed.enabled_lenses.length : undefined;\n127\t  return { refutations, nEnabled };\n128\t}\n129\t\n130\tfunction selftest() {\n131\t  const fails = [];\n132\t  const t = (name, cond) => { if (!cond) fails.push(name); };\n133\t  const r = (lens, sev) => ({ lens, outcome: \"refuted\", objections: sev ? [{ severity: sev }] : [] });\n134\t  const clear = (lens) => ({ lens, outcome: \"clear\", objections: [] });\n135\t  const down = (lens, kind) => ({ lens, outcome: \"unavailable\", kind, objections: [] });\n136\t\n137\t  // strict-majority table\n138\t  t(\"majority n=1 → 1\", strictMajority(1) === 1);\n139\t  t(\"majority n=2 → 2\", strictMajority(2) === 2);\n140\t  t(\"majority n=3 → 2\", strictMajority(3) === 2);\n141\t  t(\"majority n=4 → 3\", strictMajority(4) === 3);\n142\t\n143\t  // severity mapping\n144\t  t(\"critical→blocker\", mapSeverity(\"critical\") === \"blocker\");\n145\t  t(\"major→major\", mapSeverity(\"major\") === \"major\");\n146\t  t(\"minor→minor\", mapSeverity(\"minor\") === \"minor\");\n147\t  t(\"observation→null\", mapSeverity(\"observation\") === null);\n148\t  t(\"unknown→null\", mapSeverity(\"bogus\") === null);\n149\t\n150\t  // scenario: 2 refuted (major) of 4, no critical → revise\n151\t  let v = aggregate([r(\"architectural\", \"major\"), r(\"infosec\", \"major\"), clear(\"methodology\"), clear(\"QA\")], 4);\n152\t  t(\"2/4 major → revise\", v.verdict === \"revise\" && v.objections.length === 2);\n153\t  // a third refuting lens flips to reject-approach\n154\t  v = aggregate([r(\"architectural\", \"major\"), r(\"infosec\", \"major\"), r(\"methodology\", \"major\"), clear(\"QA\")], 4);\n155\t  t(\"3/4 major → reject-approach\", v.verdict === \"reject-approach\");\n156\t\n157\t  // any critical → reject-approach regardless\n158\t  v = aggregate([r(\"architectural\", \"critical\"), clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n159\t  t(\"1 critical → reject-approach\", v.verdict === \"reject-approach\" && v.objections[0].severity === \"blocker\");\n160\t\n161\t  // all clear → approve, []\n162\t  v = aggregate([clear(\"architectural\"), clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n163\t  t(\"all clear → approve []\", v.verdict === \"approve\" && v.objections.length === 0);\n164\t\n165\t  // config-fault unavailable lens, others clear → needs-human, names the lens\n166\t  v = aggregate([down(\"infosec\", \"config-fault\"), clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n167\t  t(\"config-fault → needs-human\", v.verdict === \"needs-human\");\n168\t  t(\"config-fault names lens\", v.objections.some((o) => o.lens === \"infosec\" && o.severity === \"blocker\"));\n169\t\n170\t  // FAFF-900: infra-configured down lens that could swing → unavailable (never needs-human — a\n171\t  // transient the orchestrator can hold/retry), named as a \"major\" objection.\n172\t  v = aggregate([down(\"infosec\", \"infra-configured\"), clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n173\t  t(\"infra-down swing → unavailable\", v.verdict === \"unavailable\");\n174\t  t(\"infra-down swing names lens as major\", v.objections.some((o) => o.lens === \"infosec\" && o.severity === \"major\"));\n175\t\n176\t  // infra-configured down lens that cannot swing (available already force reject via critical) → reject-approach\n177\t  v = aggregate([down(\"infosec\", \"infra-configured\"), r(\"architectural\", \"critical\"), clear(\"methodology\"), clear(\"QA\")], 4);\n178\t  t(\"infra-down no-swing → reject-approach\", v.verdict === \"reject-approach\");\n179\t\n180\t  // single enabled lens refuting (n=1) is already a majority → reject-approach\n181\t  v = aggregate([r(\"architectural\", \"minor\")], 1);\n182\t  t(\"n=1 minor refute → reject-approach\", v.verdict === \"reject-approach\");\n183\t\n184\t  // founded-verdict invariant: every non-approve carries ≥1 objection; approve carries none\n185\t  for (const res of [\n186\t    aggregate([r(\"architectural\", \"major\"), clear(\"infosec\")], 2),\n187\t    aggregate([down(\"infosec\", \"config-fault\"), clear(\"architectural\")], 2),\n188\t    aggregate([clear(\"architectural\")], 1),\n189\t  ]) {\n190\t    if (res.verdict === \"approve\") t(\"approve has no objections\", res.objections.length === 0);\n191\t    else t(`${res.verdict} has ≥1 objection`, res.objections.length >= 1);\n192\t  }\n193\t\n194\t  // observation-only lens is clear (advisory, non-gating)\n195\t  v = aggregate([{ lens: \"QA\", outcome: \"refuted\", objections: [{ severity: \"observation\" }] }, clear(\"architectural\")], 2);\n196\t  t(\"observation-only → clear → approve\", v.verdict === \"approve\");\n197\t\n198\t  // FAFF-935: the enrichment triple {claim, evidence, predicted_consequence} rides verbatim from\n199\t  // the input objection onto the output objection, and changes no gating decision.\n200\t  const enriched = { lens: \"architectural\", outcome: \"refuted\", objections: [{ severity: \"major\", claim: \"C\", evidence: \"E\", predicted_consequence: \"P\" }] };\n201\t  v = aggregate([enriched, clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n202\t  t(\"triple carried onto output objection\", v.objections.length === 1 && v.objections[0].claim === \"C\" && v.objections[0].evidence === \"E\" && v.objections[0].predicted_consequence === \"P\");\n203\t  t(\"triple carry keeps lens+severity\", v.objections[0].lens === \"architectural\" && v.objections[0].severity === \"major\");\n204\t  t(\"triple carry unchanged verdict\", v.verdict === \"revise\");\n205\t  // a bare {severity} objection yields no triple keys (back-compat — identical to today's shape)\n206\t  v = aggregate([r(\"architectural\", \"major\"), clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n207\t  t(\"bare objection carries no triple keys\", !(\"claim\" in v.objections[0]) && !(\"evidence\" in v.objections[0]) && !(\"predicted_consequence\" in v.objections[0]));\n208\t  // the taste-level sentinel is carried like any other string\n209\t  v = aggregate([{ lens: \"QA\", outcome: \"refuted\", objections: [{ severity: \"minor\", claim: \"less elegant\", evidence: \"sec 3\", predicted_consequence: \"not separately stated\" }] }, clear(\"architectural\"), clear(\"methodology\"), clear(\"infosec\")], 4);\n210\t  t(\"taste sentinel carried verbatim\", v.objections[0].predicted_consequence === \"not separately stated\");\n211\t  // a partial triple carries only the present strings; a non-string field is dropped (never gates)\n212\t  v = aggregate([{ lens: \"infosec\", outcome: \"refuted\", objections: [{ severity: \"major\", claim: \"auth bypass\", predicted_consequence: 42 }] }, clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n213\t  t(\"partial triple carries present string only\", v.objections[0].claim === \"auth bypass\" && !(\"evidence\" in v.objections[0]) && !(\"predicted_consequence\" in v.objections[0]));\n214\t  // transport-floor synthesized objection (down lens, no finding to grade) carries no triple\n215\t  v = aggregate([down(\"infosec\", \"config-fault\"), clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n216\t  t(\"synthesized objection carries no triple\", v.objections.some((o) => o.lens === \"infosec\" && !(\"claim\" in o)));\n217\t  // FAFF-943: spec_anchor rides verbatim beside the triple, changes no verdict, and an absent /\n218\t  // non-string / synthesized-objection anchor stays absent (the FAFF-930 absence-path precondition).\n219\t  const anchored = { lens: \"architectural\", outcome: \"refuted\", objections: [{ severity: \"major\", claim: \"C\", evidence: \"E\", predicted_consequence: \"P\", spec_anchor: \"aggregation-carry-the-anchor\" }] };\n220\t  v = aggregate([anchored, clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n221\t  t(\"anchor carried onto output objection\", v.objections[0].spec_anchor === \"aggregation-carry-the-anchor\");\n222\t  t(\"anchor carry unchanged verdict\", v.verdict === \"revise\");\n223\t  v = aggregate([r(\"architectural\", \"major\"), clear(\"infosec\"), clear(\"methodology\"), clear(\"QA\")], 4);\n224\t  t(\"bare objection carries no anchor key\", !(\"spec_anchor\" in v.objections[0]));\n225\t  v = aggregate([{ lens: \"QA\", outcome: \"refuted\", objections: [{ severity: \"minor\", spec_anchor: \"\" }] }, clear(\"architectural\"), clear(\"methodology\"), clear(\"infosec\")], 4);\n226\t  t(\"empty-string anchor carried verbatim\", v.objections[0].spec_anchor === \"\");\n227\t  v = aggregate([{ lens: \"infosec\", outcome: \"refuted\", objections: [{ severity: \"major\", spec_anchor: 42 }] }, clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n228\t  t(\"non-string anchor dropped\", !(\"spec_anchor\" in v.objections[0]));\n229\t  v = aggregate([down(\"infosec\", \"config-fault\"), clear(\"architectural\"), clear(\"methodology\"), clear(\"QA\")], 4);\n230\t  t(\"synthesized objection carries no anchor\", v.objections.some((o) => o.lens === \"infosec\" && !(\"spec_anchor\" in o)));\n231\t\n232\t  if (fails.length) {\n233\t    process.stderr.write(\"aggregate --selftest: FAIL\\n\" + fails.map((f) => \"  ✗ \" + f).join(\"\\n\") + \"\\n\");\n234\t    return 1;\n235\t  }\n236\t  process.stdout.write(\"aggregate --selftest: ok\\n\");\n237\t  return 0;\n238\t}\n239\t\n240\tfunction main(argv) {\n241\t  const args = argv.slice(2);\n242\t  if (args.includes(\"--selftest\")) return selftest();\n243\t  let input;\n244\t  try {\n245\t    input = readInput(args);\n246\t  } catch (e) {\n247\t    process.stderr.write(`aggregate: cannot read refutations JSON — ${e.message}\\n`);\n248\t    return 2;\n249\t  }\n250\t  const ni = args.indexOf(\"--n\");\n251\t  const nEnabled = ni !== -1 ? parseInt(args[ni + 1], 10) : input.nEnabled;\n252\t  // Fail-SAFE input-adequacy guard (the L4 \"a down refuter never silently approves\" discipline,\n253\t  // applied to the aggregation boundary). The pure aggregate() computes the gate over a CONSISTENT\n254\t  // set (one entry per enabled lens); the CLI refuses to vote on an absent or inconsistent set rather\n255\t  // than fabricate an `approve` from it. A non-zero exit here is treated upstream as `needs-human`,\n256\t  // exactly as a non-zero review-call.mjs exit is — never a silent pass.\n257\t  if (input.refutations.length === 0) {\n258\t    process.stderr.write(\"aggregate: no refutations supplied — refusing to vote (an empty set would silently approve; treat as needs-human)\\n\");\n259\t    return 3;\n260\t  }\n261\t  if (Number.isInteger(nEnabled) && nEnabled > 0 && input.refutations.length !== nEnabled) {\n262\t    process.stderr.write(`aggregate: refutation count (${input.refutations.length}) != enabled-lens count (${nEnabled}) — refusing to vote on an inconsistent set (treat as needs-human)\\n`);\n263\t    return 3;\n264\t  }\n265\t  const result = aggregate(input.refutations, nEnabled);\n266\t  process.stdout.write(renderBlock(result));\n267\t  return 0;\n268\t}\n269\t\n270\t// Run as CLI only when invoked directly (not when imported by the test).\n271\t// `import.meta.url` is a percent-encoded file: URL; build the comparison URL from process.argv[1]\n272\t// via pathToFileURL so it encodes identically. Concatenating the file scheme with the raw path\n273\t// under-encodes URL-special chars (e.g. an interpunct in a worktree branch dir), silently failing\n274\t// the equality and no-op'ing main() on a gate component (FAFF-464). FAFF-813: faff installs each\n275\t// skill by symlinking `plugin/skills/<skill>/` into `~/.claude/skills/<skill>`, so a production\n276\t// invocation's process.argv[1] is the symlink path while import.meta.url is already the repo\n277\t// realpath — canonicalise argv1 through realpathSync before comparing so a symlinked install path\n278\t// still matches.\n279\texport function entrypoint_href(argv1) {\n280\t  if (!argv1) return null;\n281\t  try {\n282\t    return pathToFileURL(realpathSync(argv1)).href;\n283\t  } catch {\n284\t    return pathToFileURL(argv1).href;\n285\t  }\n286\t}\n287\t\n288\tif (import.meta.url === entrypoint_href(process.argv[1])) {\n289\t  process.exit(main(process.argv));\n290\t}\n291\t"}]},"parent_tool_use_id":"toolu_018uez6EFKiHNDKixT1pCgLF","session_id":"21bdc136-befe-4bc5-9026-5312f63ae86b","uuid":"7f6c6064-fdfb-41fb-85d2-388953e4df9a","timestamp":"2026-09-01T01:35:22.497Z","subagent_type":"general-purpose","task_description":"Resume E1 spec-review gate"}
