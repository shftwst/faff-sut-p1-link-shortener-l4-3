{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0129F3fJiE8tF2Jc4PhPCfyK","type":"tool_result","content":"278\tfunction prdrAccept(dir, root, number, { actor, admitVerdictJson, noBranch, cfg } = {}) {\n279\t  const rec = (() => { const d = String(number || \"\").match(/^(\\d{1,4})/); return d ? listPrdrs(dir).find((a) => a.num === d[1].padStart(4, \"0\")) : null; })();\n280\t  if (!rec) return { code: 1, err: `faff prdr accept: no PRDR matching \"${number}\" in ${path.relative(root, dir) || dir}\\n` };\n281\t  if (/^(Accepted|Rejected|Superseded)/i.test(rec.status || \"\")) return { code: 1, err: `faff prdr accept: PRDR-${rec.num} Status is already terminal (\"${(rec.status || \"\").split(/[ (.]/)[0]}\") — accept only flips Proposed\\n` };\n282\t  if (!gitOk(root, [\"rev-parse\", \"--is-inside-work-tree\"])) return { code: 1, err: `faff prdr accept: not a git work tree — accept is a git gesture\\n` };\n283\t  const curBranch = gitOut(root, [\"symbolic-ref\", \"--quiet\", \"--short\", \"HEAD\"]);\n284\t  if (!curBranch) return { code: 1, err: `faff prdr accept: HEAD is detached — no branch to restore or to carry the commit\\n` };\n285\t\n286\t  if (actor === \"loop\") {\n287\t    if (!admitVerdictJson) return { code: 2, err: `faff prdr accept: --actor loop requires --admit-verdict '<json>'\\n` };\n288\t    let parsed; try { parsed = JSON.parse(admitVerdictJson); } catch { return { code: 2, err: `faff prdr accept: --admit-verdict is not valid JSON\\n` }; }\n289\t    const sc = schemaCheck(parsed, \"prdr-admission\");\n290\t    if (sc) return { code: 2, err: `faff prdr accept: --admit-verdict fails prdr-admission schema: ${sc}\\n` };\n291\t    if (parsed.disposition !== \"admit\") return { code: 1, err: `faff prdr accept: --admit-verdict disposition is \"${parsed.disposition}\", not \"admit\" — the loop may only accept an admitted PRDR\\n` };\n292\t  }\n293\t\n294\t  const filePath = path.join(dir, rec.file);\n295\t  const base = noBranch ? curBranch : resolveDefaultBase(root);\n296\t  const prefix = (cfg && cfg[\"prdr.accept_branch_prefix\"]) || DEFAULTS[\"prdr.accept_branch_prefix\"];\n297\t  const landing = `${prefix}${rec.num}-${adrSlug(rec.title || rec.slug || \"prdr\")}`;\n298\t\n299\t  // --- branch setup (skipped for --no-branch): NOTHING is mutated until a switch succeeds ---\n300\t  if (!noBranch) {\n301\t    if (gitOut(root, [\"diff\", \"--cached\", \"--name-only\"])) return { code: 1, err: `faff prdr accept: the index has staged changes — commit or reset them first (accept must not smuggle unrelated work)\\n` };\n302\t    if (gitOk(root, [\"show-ref\", \"--verify\", \"--quiet\", `refs/heads/${landing}`])) return { code: 1, err: `faff prdr accept: landing branch \"${landing}\" already exists — delete it or use --no-branch\\n` };\n303\t    const sw = git(root, [\"switch\", \"-c\", landing, base]);\n304\t    if (sw.status !== 0) return { code: 1, err: `faff prdr accept: could not create landing branch \"${landing}\" off \"${base}\" (nothing mutated): ${(sw.stderr || \"\").trim()}\\n` };\n305\t  }\n306\t\n307\t  // --- the mutation, strictly AFTER a successful switch — on the landing branch, never the original ---\n308\t  const orig = fs.readFileSync(filePath, \"utf8\");\n309\t  const restore = (extra) => {  // full rollback: unstage, restore file content, restore branch, drop landing\n310\t    try { git(root, [\"reset\", \"-q\"]); } catch {}          // unstage (never `git checkout -- file`, which restores the staged Accepted copy)\n311\t    try { fs.writeFileSync(filePath, orig); } catch {}     // content back to Proposed\n312\t    if (!noBranch) { git(root, [\"switch\", curBranch]); git(root, [\"branch\", \"-D\", landing]); }\n313\t    return extra;\n314\t  };\n315\t  fs.writeFileSync(filePath, orig.replace(/^([\\s>*-]*\\*{0,2}Status[ \\t*]*:[ \\t*]*).*$/mi, \"$1Accepted\"));\n316\t  const relPath = path.relative(root, filePath) || rec.file;\n317\t  const add = git(root, [\"add\", \"--\", relPath]);\n318\t  if (add.status !== 0) return { code: 1, ...restore({ err: `faff prdr accept: git add failed (rolled back — Status still Proposed): ${(add.stderr || \"\").trim()}\\n` }) };\n319\t  const commit = git(root, [\"commit\", \"-m\", `docs(prdr): accept PRDR-${rec.num} — ${rec.title || rec.slug}`]);\n320\t  if (commit.status !== 0) return { code: 1, ...restore({ err: `faff prdr accept: git commit failed (rolled back — Status still Proposed): ${(commit.stderr || \"\").trim()}\\n` }) };\n321\t\n322\t  // --- success: return to the original branch (the landing branch holds the commit) ---\n323\t  let warn = \"\";\n324\t  if (!noBranch) { const back = git(root, [\"switch\", curBranch]); if (back.status !== 0) warn = `warning: commit landed on \"${landing}\" but could not switch back to \"${curBranch}\" — run: git switch ${curBranch}\\n`; }\n325\t  return { code: 0, out: JSON.stringify({ file: filePath, branch: noBranch ? curBranch : landing, base }) + \"\\n\", err: warn };\n326\t}\n327\t\n328\t// === FAFF-875: `faff prdr land --local` — land an Accepted doc-only PRDR onto `main` in a\n329\t// no-remote repo. A sibling landing gate to `merge-gate --local` (D1: never an overload of it) —\n330\t// narrower (doc-only, PRDR-shaped preconditions), reusing the same ff-only base-advance\n331\t// primitive (`landBaseFfOnly`, extracted out of merge-gate.js) rather than forking it. ===\n332\t\n333\t// D3.3 — segment-anchored containment: every path the land would introduce must stay wholly\n334\t// under the configured PRDR directory. `prefix` is ALREADY trailing-slash-stripped\n335\t// (resolvePrdrDocsPath's own contract). Deliberately NOT a bare `startsWith(prefix)` — that\n336\t// would admit a sibling-prefix escape like `records/prdr-notes/evil.js` (the round-1 review's\n337\t// infosec finding); a segment boundary (`prefix + \"/\"`) plus a traversal-segment guard is the\n338\t// precedent `deriveAnchorDirs` (governance-check.js) already established for the same shape of\n339\t// problem. `f === prefix` (a path equal to the directory itself, no separator) also passes, per\n340\t// the spec's own predicate — an edge case no real `git diff --name-only` row produces (that\n341\t// command never emits a bare directory path) but harmless to admit.\n342\tfunction landPathAllowed(f, prefix) {\n343\t  if (typeof f !== \"string\" || !f) return false;\n344\t  if (f !== prefix && !f.startsWith(prefix + \"/\")) return false;\n345\t  return f.split(\"/\").every((seg) => seg !== \".\" && seg !== \"..\" && seg !== \"\");\n346\t}\n347\t\n348\t// D3.4 — candidate validation runs against the LANDING TREE (the state `main` would have once\n349\t// landed), never the current filesystem (which, in the common single-worktree flow, still shows\n350\t// the base copy — still Proposed, since `accept` only ever touches the landing branch). Follows\n351\t// the post-merge.js `git worktree add --detach` precedent: materialise `ref` into a throwaway\n352\t// detached worktree, run the existing FAFF-463 validators (`prdrValidate` + `prdrGitTier`)\n353\t// against THAT tree, then always clean up (a stray worktree entry is the one failure mode the\n354\t// `finally` exists to prevent). Returns a flat problems[] (empty ⟹ clean).\n355\tfunction landCandidateProblems(root, ref) {\n356\t  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), \"faff-prdr-land-\"));\n357\t  try {\n358\t    const added = spawnSync(\"git\", [\"worktree\", \"add\", \"--detach\", tmp, ref], { cwd: root, encoding: \"utf8\" });\n359\t    if (added.status !== 0) return [`could not materialise the candidate tree at ${ref}: ${((added.stderr || \"\") + (added.stdout || \"\")).trim().slice(-300)}`];\n360\t    const candidateCfg = loadConfig(tmp)[0];\n361\t    const candidateDir = prdrDir(tmp);\n362\t    const problems = prdrValidate(candidateDir);\n363\t    const { fails } = prdrGitTier(candidateDir, tmp, candidateCfg);\n364\t    return problems.concat(fails);\n365\t  } finally {\n366\t    spawnSync(\"git\", [\"worktree\", \"remove\", \"--force\", tmp], { cwd: root, encoding: \"utf8\" });\n367\t    try { fs.rmSync(tmp, { recursive: true, force: true }); } catch { /* best effort */ }\n368\t  }\n369\t}\n370\t\n371\t// The full `land` procedure (D2–D6), kept as its own function (mirrors `prdrAccept`'s shape) so\n372\t// `cmdPrdr`'s `land` branch stays a thin flag-parse + dispatch, and so the selftest can drive it\n373\t// directly without shelling the CLI. Returns { code, out?, err? } — `out` is the D5 JSON record\n374\t// on success (always emitted, `--json` or not — the auditable landing record, per spec D5).\n375\tfunction prdrLand(dir, root, number, { baseFlag, prdGoalsRaw, runDir, issue, cfg } = {}) {\n376\t  // D2.1 — no-remote gate (indeterminate fails toward \"has a remote\", fail-closed).\n377\t  const remoteEmpty = gitRemoteEmpty(root);\n378\t  if (remoteEmpty !== true) {\n379\t    return { code: 2, err: \"faff prdr land --local: repo has a remote (or its remote-state is indeterminate) — land an Accepted PRDR via the forge PR path\\n\" };\n380\t  }\n381\t\n382\t  const d = String(number || \"\").match(/^(\\d{1,4})/);\n383\t  const num = d ? d[1].padStart(4, \"0\") : null;\n384\t  if (!num) return { code: 2, err: `faff prdr land: invalid PRDR number \"${number}\"\\n` };\n385\t\n386\t  // D2.3 — the landing branch must exist and be one `faff prdr accept` produced. Discovered by\n387\t  // NUMBER-PREFIXED GLOB on refs/heads (`git for-each-ref`), never by recomputing the expected"}]},"parent_tool_use_id":"toolu_01B5EZakvE3ogy965XNLhXi4","session_id":"21bdc136-befe-4bc5-9026-5312f63ae86b","uuid":"45199915-7740-40e2-80f0-d5e7b1513c9b","timestamp":"2026-09-01T00:39:39.399Z","subagent_type":"general-purpose","task_description":"Plot PRD into epics and PRDRs"}
