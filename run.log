{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012AvavvdQANbY7mcDknHRsT","type":"tool_result","content":"264 evaluate-call.mjs\n25:// criteria + aggregate ONLY. The SPAWNER owns the envelope — it derives code_blind,\n83:// evaluator contributes criteria + aggregate ONLY; the spawner overwrites code_blind\n85:// exactly what `faff contract holdout-verdict` validates (criteria items:\n86:// {class, verdict, evidence_present}; aggregate a string; violations a string[]).\n89:  const criteria = Array.isArray(inner.criteria) ? inner.criteria : [];\n90:  const aggregate = typeof inner.aggregate === \"string\" ? inner.aggregate : \"needs-human\";\n94:  const env = { aggregate, code_blind: att.code_blind, criteria, violations, spawner_attested: att.spawner_attested };\n105:    default: return EXIT.OTHER;   // \"error\"/unknown — an inner fault the caller reads as needs-human\n173:  // Step 3a — the in-cage preflight MUST hold before judging. A refusal is exit 10 → needs-human; teardown\n177:    process.stderr.write(`evaluate-call: in-cage preflight REFUSED — ${(pf.refusals || []).map((r) => `${r.leg}: ${r.detail}`).join(\"; \")}; exit ${EXIT.PREFLIGHT_REFUSED} → needs-human\\n`);\n192:    process.stderr.write(`evaluate-call: engine ${res && res.status}; exit ${exit} → needs-human\\n`);\n218:  const a1 = deriveAttestation(true, { aggregate: \"meets-spec\", criteria: [] }, withheld);\n222:  const a2 = deriveAttestation(true, { aggregate: \"meets-spec\", criteria: [], code_blind: false }, withheld);\n226:  const a3 = deriveAttestation(true, { aggregate: \"meets-spec\", criteria: [], saw_code: true }, withheld);\n230:  const a4 = deriveAttestation(true, { aggregate: \"meets-spec\", criteria: [], code_blind: true }, withheld);\n234:  const a5 = deriveAttestation(false, { aggregate: \"meets-spec\", criteria: [] }, withheld);\n237:  // envelope assembly: inner criteria/aggregate carried, spawner fields stamped\n238:  const e1 = assembleEnvelope({ aggregate